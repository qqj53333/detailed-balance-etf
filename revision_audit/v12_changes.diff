+++ v12/source/prepare_crossrefs.py
@@ -0,0 +1,32 @@
+"""Prepare only external labels needed by the separate LaTeX entry points.
+
+Run after: tectonic -k source/preprint.tex
+This avoids duplicate local labels/citations from importing the complete AUX.
+External references are printed as numbers, without misleading local links.
+"""
+from pathlib import Path
+import re
+
+root=Path(__file__).resolve().parent
+def expanded(path):
+    text=path.read_text(encoding='utf-8')
+    for name in re.findall(r'\\input\{([^}]+)\}',text):
+        child=root/name
+        if not child.suffix:
+            child=child.with_suffix('.tex')
+        text+='\n'+expanded(child)
+    return text
+
+main='\n'.join(expanded(root/name) for name in ['body.tex','tables.tex','figures.tex'])
+app=expanded(root/'appendix_body.tex')
+groups={'main_crossrefs':set(re.findall(r'\\label\{([^}]+)\}',main)),
+        'appendix_crossrefs':set(re.findall(r'\\label\{([^}]+)\}',app))}
+aux=(root/'preprint.aux').read_text(encoding='utf-8')
+entries=re.findall(r'\\newlabel\{([^}]+)\}\{\{([^}]+)\}\{([^}]+)\}',aux)
+for name,labels in groups.items():
+    lines=['% Generated by prepare_crossrefs.py; numbers only, no hyperlink destinations.']
+    for key,num,page in entries:
+        if key in labels:
+            lines.append('\\newlabel{'+key+'}{{'+num+'}{'+page+'}{}{}}')
+    (root/(name+'.aux')).write_text('\n'.join(lines)+'\n',encoding='utf-8')
+    print(name,len(lines)-1,'labels')
